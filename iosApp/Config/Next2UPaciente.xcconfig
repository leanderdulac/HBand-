// Team Next2U. Bundle stays br.com.next2u.saude.paciente.
// Do not commit a real distribution certificate.

PRODUCT_NAME = Next2U Paciente
PRODUCT_BUNDLE_IDENTIFIER = br.com.next2u.saude.paciente
DEVELOPMENT_TEAM = H87XXMXA5G
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 7
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
IPHONEOS_DEPLOYMENT_TARGET = 16.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 5.0
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Next2UPaciente/Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
SUPPORTED_PLATFORMS = iphoneos
FRAMEWORK_SEARCH_PATHS = $(inherited) $(SRCROOT)/Vendor $(SRCROOT)/Vendor/shared.framework/..
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/Vendor/VeepooBleSDK.framework/Headers
OTHER_LDFLAGS = $(inherited) -ObjC -framework JL_BLEKit -framework JLDialUnit -framework ABParTool -framework ZipZap -framework GRDFUSDK -L$(SRCROOT)/Vendor/FMDB -lFMDB -lsqlite3 -lz
ENABLE_BITCODE = NO

// Optional local secrets (gitignored): NEXT2U_INGEST_API_KEY, NEXT2U_CORE_BASE_URL,
// NEXT2U_GEMINI_API_KEY. Do not commit a real Gemini key.
// Android .env.example keeps AI_INSIGHT_ENABLED=false; pilot iOS builds enable the
// Início highlight card the same way a true Android .env does.
NEXT2U_AI_INSIGHT_ENABLED = YES
NEXT2U_GEMINI_API_KEY = YOUR_GEMINI_API_KEY
#include? "Secrets.local.xcconfig"
